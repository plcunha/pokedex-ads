# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# API Configuration (optional - uses defaults if not set)
# POKEMON_API_BASE_URL=https://pokeapi.co/api/v2
# POKEMON_API_TIMEOUT=10000
# POKEMON_API_MAX_LIMIT=1000

# Cache Configuration (optional)
# CACHE_MAX_SIZE=500
# CACHE_TTL_MS=1800000

# Redis Configuration (optional - falls back to in-memory cache if disabled)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
