<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= pokemon.displayName %> <%= t.meta.pokemonDescription %>">
  <meta name="theme-color" content="#EF4444">
  <title><%= pokemon.displayName %> #<%= String(pokemon.id).padStart(3, '0') %> - <%= t.appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-primary: #EF4444;
      --color-primary-dark: #DC2626;
      --color-secondary: #3B82F6;
      --color-bg: #0F172A;
      --color-bg-secondary: #1E293B;
      --color-card: #1E293B;
      --color-card-hover: #334155;
      --color-text: #F8FAFC;
      --color-text-muted: #94A3B8;
      --color-border: #334155;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-xl: 1rem;
      --radius-2xl: 1.5rem;
      --transition: all 0.2s ease-in-out;

      /* Type colors */
      --type-normal: #A8A878;
      --type-fire: #F08030;
      --type-water: #6890F0;
      --type-electric: #F8D030;
      --type-grass: #78C850;
      --type-ice: #98D8D8;
      --type-fighting: #C03028;
      --type-poison: #A040A0;
      --type-ground: #E0C068;
      --type-flying: #A890F0;
      --type-psychic: #F85888;
      --type-bug: #A8B820;
      --type-rock: #B8A038;
      --type-ghost: #705898;
      --type-dragon: #7038F8;
      --type-dark: #705848;
      --type-steel: #B8B8D0;
      --type-fairy: #EE99AC;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      min-height: 100vh;
      line-height: 1.6;
    }

    /* Back Navigation */
    .nav-back {
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 100;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      color: var(--color-text);
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
      backdrop-filter: blur(8px);
    }

    .back-btn:hover {
      background: var(--color-card-hover);
      border-color: var(--color-primary);
      transform: translateX(-4px);
    }

    /* Language Switcher */
    .lang-switcher {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 100;
      display: flex;
      gap: 0.5rem;
    }

    .lang-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 600;
      font-family: inherit;
      color: var(--color-text-muted);
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }

    .lang-btn:hover {
      background: var(--color-card-hover);
      color: var(--color-text);
    }

    .lang-btn.active {
      background: var(--color-primary);
      color: white;
      border-color: var(--color-primary);
    }

    /* Hero Section */
    .hero {
      position: relative;
      padding: 4rem 1rem 3rem;
      text-align: center;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, 
        var(--type-<%= pokemon.types[0] || 'normal' %>) 0%, 
        rgba(15, 23, 42, 0.9) 100%
      );
      opacity: 0.3;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 800px;
      margin: 0 auto;
    }

    .pokemon-image-container {
      position: relative;
      width: 280px;
      height: 280px;
      margin: 0 auto 2rem;
    }

    .pokemon-image-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 240px;
      height: 240px;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
      border-radius: 50%;
      animation: glow 3s ease-in-out infinite;
    }

    @keyframes glow {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
      50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; }
    }

    .pokemon-image {
      position: relative;
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 20px 40px rgba(0,0,0,0.4));
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .pokemon-id {
      display: inline-block;
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-card);
      padding: 0.375rem 0.875rem;
      border-radius: var(--radius-xl);
      margin-bottom: 0.75rem;
    }

    .pokemon-name {
      font-size: 3rem;
      font-weight: 800;
      color: var(--color-text);
      text-transform: capitalize;
      margin-bottom: 1rem;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    .pokemon-types {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .type-badge {
      padding: 0.5rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: white;
      text-transform: capitalize;
      border-radius: var(--radius-xl);
      text-shadow: 0 1px 2px rgba(0,0,0,0.2);
      box-shadow: var(--shadow-md);
    }

    <% pokemon.types.forEach(type => { %>
    .type-<%= type %> {
      background: linear-gradient(135deg, var(--type-<%= type %>) 0%, color-mix(in srgb, var(--type-<%= type %>) 80%, black) 100%);
    }
    <% }); %>

    /* Main Content */
    .main {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1rem 3rem;
    }

    /* Info Cards Grid */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .info-card {
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      text-align: center;
    }

    .info-card-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 0.75rem;
      background: var(--color-bg);
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .info-card-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
    }

    .info-card-value {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text);
    }

    /* Stats Section */
    .section {
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .stats-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .stat-row {
      display: grid;
      grid-template-columns: 140px 50px 1fr;
      align-items: center;
      gap: 1rem;
    }

    .stat-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .stat-value {
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-text);
      text-align: center;
    }

    .stat-bar-container {
      height: 10px;
      background: var(--color-bg);
      border-radius: 5px;
      overflow: hidden;
    }

    .stat-bar {
      height: 100%;
      border-radius: 5px;
      transition: width 1s ease-out;
    }

    .stat-bar.hp { background: linear-gradient(90deg, #4ADE80, #22C55E); }
    .stat-bar.attack { background: linear-gradient(90deg, #F97316, #EA580C); }
    .stat-bar.defense { background: linear-gradient(90deg, #FACC15, #EAB308); }
    .stat-bar.special-attack { background: linear-gradient(90deg, #818CF8, #6366F1); }
    .stat-bar.special-defense { background: linear-gradient(90deg, #34D399, #10B981); }
    .stat-bar.speed { background: linear-gradient(90deg, #F472B6, #EC4899); }

    /* Abilities */
    .abilities-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .ability-badge {
      padding: 0.625rem 1rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-text);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-transform: capitalize;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--color-text-muted);
      font-size: 0.875rem;
      border-top: 1px solid var(--color-border);
    }

    .footer a {
      color: var(--color-primary);
      text-decoration: none;
      transition: var(--transition);
    }

    .footer a:hover {
      color: var(--color-text);
    }

    /* Responsive */
    @media (max-width: 640px) {
      .nav-back {
        position: static;
        padding: 1rem;
      }

      .lang-switcher {
        position: static;
        justify-content: center;
        padding: 0 1rem;
        margin-top: -0.5rem;
      }

      .hero {
        padding: 2rem 1rem;
      }

      .pokemon-image-container {
        width: 200px;
        height: 200px;
      }

      .pokemon-name {
        font-size: 2rem;
      }

      .stat-row {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }

      .stat-row .stat-name {
        display: flex;
        justify-content: space-between;
      }

      .stat-row .stat-name::after {
        content: attr(data-value);
        font-weight: 700;
        color: var(--color-text);
      }

      .stat-row .stat-value {
        display: none;
      }
    }
  </style>
</head>
<body>
  <nav class="nav-back">
    <a href="/" class="back-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      <%= t.nav.back %>
    </a>
  </nav>

  <div class="lang-switcher">
    <a href="?lang=pt-BR" class="lang-btn <%= locale === 'pt-BR' ? 'active' : '' %>">PT</a>
    <a href="?lang=en" class="lang-btn <%= locale === 'en' ? 'active' : '' %>">EN</a>
  </div>

  <section class="hero">
    <div class="hero-content">
      <div class="pokemon-image-container">
        <div class="pokemon-image-bg"></div>
        <img 
          src="<%= pokemon.imageUrl %>" 
          alt="<%= pokemon.displayName %>"
          class="pokemon-image"
        >
      </div>
      <span class="pokemon-id">#<%= String(pokemon.id).padStart(3, '0') %></span>
      <h1 class="pokemon-name"><%= pokemon.displayName %></h1>
      <div class="pokemon-types">
        <% pokemon.types.forEach(type => { %>
          <span class="type-badge type-<%= type %>"><%= t.pokemon.types[type] || type %></span>
        <% }); %>
      </div>
    </div>
  </section>

  <main class="main">
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-icon">📏</div>
        <p class="info-card-label"><%= t.pokemon.height %></p>
        <p class="info-card-value"><%= pokemon.height %></p>
      </div>
      <div class="info-card">
        <div class="info-card-icon">⚖️</div>
        <p class="info-card-label"><%= t.pokemon.weight %></p>
        <p class="info-card-value"><%= pokemon.weight %></p>
      </div>
      <div class="info-card">
        <div class="info-card-icon">⭐</div>
        <p class="info-card-label"><%= t.pokemon.baseExperience %></p>
        <p class="info-card-value"><%= pokemon.baseExperience %></p>
      </div>
    </div>

    <section class="section">
      <h2 class="section-title">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18"></path>
          <path d="m19 9-5 5-4-4-3 3"></path>
        </svg>
        <%= t.pokemon.baseStats %>
      </h2>
      <div class="stats-list">
        <% pokemon.stats.forEach(stat => { %>
          <div class="stat-row">
            <span class="stat-name" data-value="<%= stat.value %>"><%= stat.displayName %></span>
            <span class="stat-value"><%= stat.value %></span>
            <div class="stat-bar-container">
              <div 
                class="stat-bar <%= stat.name %>" 
                style="width: <%= stat.percentage %>%;"
              ></div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2 2 7l10 5 10-5-10-5Z"></path>
          <path d="m2 17 10 5 10-5"></path>
          <path d="m2 12 10 5 10-5"></path>
        </svg>
        <%= t.pokemon.abilities %>
      </h2>
      <div class="abilities-list">
        <% pokemon.abilities.forEach(ability => { %>
          <span class="ability-badge"><%= ability %></span>
        <% }); %>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>
      <%= t.footer.copyright %> &copy; <%= new Date().getFullYear() %> &bull;
      <%= t.footer.dataProvidedBy %> <a href="https://pokeapi.co/" target="_blank" rel="noopener noreferrer">PokéAPI</a>
    </p>
  </footer>
</body>
</html>
