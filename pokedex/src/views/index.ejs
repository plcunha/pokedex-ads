<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Pokédex Pro - Explore todos os Pokémon com informações detalhadas">
  <meta name="theme-color" content="#EF4444">
  <title>Pokédex Pro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-primary: #EF4444;
      --color-primary-dark: #DC2626;
      --color-secondary: #3B82F6;
      --color-bg: #0F172A;
      --color-bg-secondary: #1E293B;
      --color-card: #1E293B;
      --color-card-hover: #334155;
      --color-text: #F8FAFC;
      --color-text-muted: #94A3B8;
      --color-border: #334155;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-xl: 1rem;
      --radius-2xl: 1.5rem;
      --transition: all 0.2s ease-in-out;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      min-height: 100vh;
      line-height: 1.6;
    }

    /* Header */
    .header {
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
      padding: 2rem 1rem 3rem;
      position: relative;
      overflow: hidden;
    }

    .header::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 50%);
      animation: pulse 15s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    .header-content {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .logo-icon {
      width: 48px;
      height: 48px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .logo-text {
      font-size: 2rem;
      font-weight: 800;
      color: white;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    /* Search Form */
    .search-form {
      display: flex;
      max-width: 500px;
      margin: 0 auto;
      gap: 0.5rem;
    }

    .search-input {
      flex: 1;
      padding: 0.875rem 1.25rem;
      font-size: 1rem;
      font-family: inherit;
      border: 2px solid transparent;
      border-radius: var(--radius-xl);
      background: rgba(255,255,255,0.95);
      color: var(--color-bg);
      transition: var(--transition);
      outline: none;
    }

    .search-input::placeholder {
      color: #64748B;
    }

    .search-input:focus {
      border-color: var(--color-secondary);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
    }

    .search-btn {
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      font-family: inherit;
      color: var(--color-primary);
      background: white;
      border: none;
      border-radius: var(--radius-xl);
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .search-btn:hover {
      background: var(--color-text);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    /* Main Content */
    .main {
      max-width: 1200px;
      margin: -2rem auto 0;
      padding: 0 1rem 3rem;
      position: relative;
      z-index: 2;
    }

    /* Pokemon Grid */
    .pokemon-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.25rem;
      list-style: none;
    }

    .pokemon-card {
      background: var(--color-card);
      border-radius: var(--radius-xl);
      overflow: hidden;
      transition: var(--transition);
      border: 1px solid var(--color-border);
    }

    .pokemon-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-xl);
      border-color: var(--color-primary);
    }

    .pokemon-link {
      display: block;
      text-decoration: none;
      color: inherit;
      padding: 1.25rem;
    }

    .pokemon-image-wrapper {
      position: relative;
      padding-top: 100%;
      background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-card) 100%);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .pokemon-image {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 85%;
      height: 85%;
      object-fit: contain;
      transition: transform 0.3s ease;
      filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
    }

    .pokemon-card:hover .pokemon-image {
      transform: translate(-50%, -50%) scale(1.1);
    }

    .pokemon-id {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-bottom: 0.25rem;
    }

    .pokemon-name {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--color-text);
      text-transform: capitalize;
    }

    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      margin-top: 2.5rem;
      flex-wrap: wrap;
    }

    .pagination-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      color: var(--color-text);
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }

    .pagination-btn:hover:not(:disabled) {
      background: var(--color-card-hover);
      border-color: var(--color-primary);
    }

    .pagination-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .pagination-info {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      padding: 0.75rem 1rem;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--color-text-muted);
      font-size: 0.875rem;
      border-top: 1px solid var(--color-border);
    }

    .footer a {
      color: var(--color-primary);
      text-decoration: none;
      transition: var(--transition);
    }

    .footer a:hover {
      color: var(--color-text);
    }

    /* Loading State */
    .loading {
      display: flex;
      justify-content: center;
      padding: 3rem;
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid var(--color-border);
      border-top-color: var(--color-primary);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Responsive */
    @media (max-width: 640px) {
      .header {
        padding: 1.5rem 1rem 2.5rem;
      }

      .logo-text {
        font-size: 1.5rem;
      }

      .search-form {
        flex-direction: column;
      }

      .search-btn {
        justify-content: center;
      }

      .pokemon-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
      }

      .pokemon-link {
        padding: 1rem;
      }

      .pokemon-name {
        font-size: 1rem;
      }
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="header-content">
      <div class="logo">
        <div class="logo-icon">🔴</div>
        <h1 class="logo-text">Pokédex Pro</h1>
      </div>
      <form action="/search" method="get" class="search-form">
        <input 
          type="text" 
          name="query" 
          class="search-input"
          placeholder="Buscar Pokémon por nome ou número..."
          autocomplete="off"
          required
        >
        <button type="submit" class="search-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          Buscar
        </button>
      </form>
    </div>
  </header>

  <main class="main">
    <ul class="pokemon-grid">
      <% pokemons.forEach(pokemon => { %>
        <li class="pokemon-card">
          <a href="/pokemon/<%= pokemon.name %>" class="pokemon-link">
            <div class="pokemon-image-wrapper">
              <img 
                src="<%= pokemon.imageUrl %>" 
                alt="<%= pokemon.displayName %>"
                class="pokemon-image"
                loading="lazy"
              >
            </div>
            <p class="pokemon-id">#<%= String(pokemon.id).padStart(3, '0') %></p>
            <h2 class="pokemon-name"><%= pokemon.displayName %></h2>
          </a>
        </li>
      <% }); %>
    </ul>

    <nav class="pagination">
      <% if (pagination.hasPrev) { %>
        <a href="/?page=<%= pagination.current - 1 %>" class="pagination-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          Anterior
        </a>
      <% } else { %>
        <button class="pagination-btn" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          Anterior
        </button>
      <% } %>

      <span class="pagination-info">Página <%= pagination.current %> de <%= pagination.total %></span>

      <% if (pagination.hasNext) { %>
        <a href="/?page=<%= pagination.current + 1 %>" class="pagination-btn">
          Próximo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      <% } else { %>
        <button class="pagination-btn" disabled>
          Próximo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      <% } %>
    </nav>
  </main>

  <footer class="footer">
    <p>
      Pokédex Pro &copy; <%= new Date().getFullYear() %> &bull;
      Dados fornecidos por <a href="https://pokeapi.co/" target="_blank" rel="noopener noreferrer">PokéAPI</a>
    </p>
  </footer>
</body>
</html>
